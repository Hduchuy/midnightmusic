# Render will provide these values
NODE_ENV=production
PORT=10000

# For local development, create .env with:
# NODE_ENV=local
# PORT=3001

# SoundCloud API credentials (optional - only needed for SoundCloud search proxy)
# SOUNDCLOUD_CLIENT_ID=your_client_id_here

# Extra allowed browser origins for CORS + Socket.io (comma-separated). Use for Vercel preview URLs.
# FRONTEND_ORIGINS=https://your-app.vercel.app,https://your-app-git-main.vercel.app
